# Paper/live market data socket for an already logged-in TWS or IB Gateway.
# Common defaults: TWS paper 7497; IB Gateway paper 4002. Confirm in your app.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=71
IBKR_SYMBOL=AAPL
IBKR_CURRENCY=USD
IBKR_EXCHANGE=SMART
IBKR_DEPTH_ROWS=5
IBKR_TICK_SIZE=0.01
IBKR_CAPTURE_DIR=data/ibkr
IBKR_SECONDS=60
IBKR_QUEUE_CAPACITY=65536
